<Window x:Class="Calder.VendorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calder Test Vendor App" Width="420" Height="380" ResizeMode="CanMinimize">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="150" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
      <Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectButton" Content="Connect"
              Width="90" Margin="0,0,8,0" Click="OnConnect" />
      <Button x:Name="DisconnectButton" AutomationProperties.AutomationId="DisconnectButton" Content="Disconnect"
              Width="90" Click="OnDisconnect" />
    </StackPanel>

    <Label x:Name="SetpointLabel" Grid.Row="1" Content="Setpoint (°C)" Target="{Binding ElementName=SetpointBox}" />
    <TextBox x:Name="SetpointBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Text="25"
             AutomationProperties.AutomationId="SetpointBox"
             AutomationProperties.LabeledBy="{Binding ElementName=SetpointLabel}" />

    <Label x:Name="RateLabel" Grid.Row="2" Content="Rate (°C/min)" Target="{Binding ElementName=RateBox}" />
    <TextBox x:Name="RateBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Text="1"
             AutomationProperties.AutomationId="RateBox"
             AutomationProperties.LabeledBy="{Binding ElementName=RateLabel}" />

    <Button x:Name="ApplyButton" Grid.Row="3" Grid.Column="1" Content="Apply" HorizontalAlignment="Left" Width="90"
            Margin="0,4" AutomationProperties.AutomationId="ApplyButton" Click="OnApply" />

    <Label x:Name="ModeLabel" Grid.Row="4" Content="Mode" Target="{Binding ElementName=ModeSelector}" />
    <ComboBox x:Name="ModeSelector" Grid.Row="4" Grid.Column="1" Margin="0,4"
              AutomationProperties.AutomationId="ModeSelector"
              AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}"
              SelectionChanged="OnModeChanged" />

    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
      <Button x:Name="StartButton" AutomationProperties.AutomationId="StartButton" Content="Start" Width="90"
              Margin="0,0,8,0" Click="OnStart" />
      <Button x:Name="StopButton" AutomationProperties.AutomationId="StopButton" Content="Stop" Width="90"
              Click="OnStop" />
    </StackPanel>

    <Label x:Name="DisplayLabel" Grid.Row="6" Content="Temperature (°C)" Target="{Binding ElementName=Display}" />
    <TextBox x:Name="Display" Grid.Row="6" Grid.Column="1" Margin="0,4" IsReadOnly="True"
             AutomationProperties.AutomationId="Display"
             AutomationProperties.LabeledBy="{Binding ElementName=DisplayLabel}" />

    <TextBlock x:Name="StatusText" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap"
               AutomationProperties.AutomationId="StatusText" Text="Disconnected" />
  </Grid>
</Window>
