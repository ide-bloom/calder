"""Typed messages of the {{ ctx.title }} protocol.

Generated by Calder {{ ctx.calder_version }} from recorded sessions. Values are in
engineering units; scaling to wire representation happens in the codec.
"""

from __future__ import annotations

from collections.abc import Mapping
from dataclasses import dataclass
{% if int_enums and str_enums %}
from enum import IntEnum, StrEnum
{% elif int_enums %}
from enum import IntEnum
{% elif str_enums %}
from enum import StrEnum
{% endif %}
from typing import Any, ClassVar
{% for e in ctx.enums %}


class {{ e.name }}({{ e.base }}):
    """{{ e.doc }}"""

{% for mem, lit, label in e.members %}
    {{ mem }} = {{ lit }}
{% endfor %}
{% endfor %}
{% for m in ctx.messages %}


@dataclass(frozen=True)
class {{ m.class_name }}:
    """Request {{ m.name }} ({{ m.classification }})."""

    MESSAGE_ID: ClassVar[str] = {{ m.id|tojson }}
{% for f in m.inputs %}
    {{ f.name }}: {{ f.py_type }}
{% endfor %}

    def values(self) -> dict[str, Any]:
{% if m.inputs %}
        return {
{% for f in m.inputs %}
            {{ f.key|tojson }}: self.{{ f.name }},
{% endfor %}
        }
{% else %}
        return {}
{% endif %}
{% endfor %}
{% for r in ctx.responses %}


@dataclass(frozen=True)
class {{ r.class_name }}:
    """Instrument message {{ r.name }} ({{ r.kind }})."""

    MESSAGE_ID: ClassVar[str] = {{ r.id|tojson }}
{% for f in r.outputs %}
    {{ f.name }}: {{ f.py_type }}
{% endfor %}

    @classmethod
    def from_values(cls, values: Mapping[str, Any]) -> {{ r.class_name }}:
{% if r.outputs %}
        return cls(
{% for f in r.outputs %}
            {{ f.name }}={{ conv(f) }},
{% endfor %}
        )
{% else %}
        del values
        return cls()
{% endif %}
{% endfor %}


UNITS: dict[str, str] = {
{% for m in ctx.messages %}
{% for f in m.inputs if f.units %}
    {{ (m.method ~ "." ~ f.name)|tojson }}: {{ f.units|tojson }},
{% endfor %}
{% endfor %}
{% for r in ctx.responses %}
{% for f in r.outputs if f.units %}
    {{ (r.method ~ "." ~ f.name)|tojson }}: {{ f.units|tojson }},
{% endfor %}
{% endfor %}
}
