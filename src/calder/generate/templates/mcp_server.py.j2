"""MCP server for the {{ ctx.title }} instrument.

Read-only and configuring commands are exposed directly. Commands classified as
actuating (they can move, heat, dispense or otherwise change the physical
state) refuse to run unless the caller passes ``confirm=true``.

Run: ``python -m {{ ctx.package }}.mcp_server --resource <port|host:port>`` (stdio transport),
or ``--simulate`` to drive the replay simulator.
"""

from __future__ import annotations

import argparse
{% if uses_asdict %}
from dataclasses import asdict
{% endif %}
from typing import Any

from mcp.server.mcpserver import MCPServer
from mcp.server.mcpserver.exceptions import ToolError
from mcp.types import ToolAnnotations

from .driver import DEFAULT_RESOURCE, {{ ctx.class_name }}
{% if imports %}
from .messages import (
{% for name in imports %}
    {{ name }},
{% endfor %}
)
{% endif %}

ACTUATING: frozenset[str] = frozenset(
    (
{% for m in ctx.messages if m.actuating %}
        {{ m.method|tojson }},
{% endfor %}
{% for a in ctx.aliases if a.actuating %}
        {{ a.name|tojson }},
{% endfor %}
    )
)
CONFIRM_HELP = (
    "This command is classified as actuating: it can change the instrument's physical "
    "state. Pass confirm=true only when an operator is present at the instrument."
)


def _require_confirmation(tool: str, confirm: bool) -> None:
    if tool in ACTUATING and not confirm:
        raise ToolError(f"{tool} is actuating and was not run. {CONFIRM_HELP}")


def create_server(driver: {{ ctx.class_name }}) -> MCPServer[Any]:
    """Build the MCP server around a connected driver."""
    server: MCPServer[Any] = MCPServer(
        name={{ ("liberated-" ~ ctx.dist_name.split("liberated-")[-1])|tojson }},
        instructions=(
            "Tools generated by Calder from recordings of the vendor software. "
            "Actuating tools require confirm=true."
        ),
    )
{% for m in ctx.messages %}

    @server.tool(
        name={{ m.method|tojson }},
        description={{ m.tool_description|tojson }},
        annotations=ToolAnnotations(
            read_only_hint={{ "True" if m.read_only else "False" }},
            destructive_hint={{ "True" if m.actuating else "False" }},
        ),
    )
    def {{ m.method }}({% for f in m.inputs %}{{ f.name }}: {{ f.py_type }}, {% endfor %}{% if m.actuating %}confirm: bool = False{% endif %}) -> {{ m.tool_return }}:
{% if m.actuating %}
        _require_confirmation({{ m.method|tojson }}, confirm)
{% endif %}
{% if m.return_kind == "none" %}
        driver.{{ m.method }}({% for f in m.inputs %}{{ f.name }}={{ f.name }}{% if not loop.last %}, {% endif %}{% endfor %})
        return "ok"
{% elif m.return_kind == "dataclass" %}
        return asdict(driver.{{ m.method }}({% for f in m.inputs %}{{ f.name }}={{ f.name }}{% if not loop.last %}, {% endif %}{% endfor %}))
{% else %}
        return driver.{{ m.method }}({% for f in m.inputs %}{{ f.name }}={{ f.name }}{% if not loop.last %}, {% endif %}{% endfor %})
{% endif %}
{% endfor %}
{% for a in ctx.aliases %}

    @server.tool(
        name={{ a.name|tojson }},
        description={{ (a.doc ~ (" " ~ "Actuating: requires confirm=true." if a.actuating else ""))|tojson }},
        annotations=ToolAnnotations(read_only_hint=False, destructive_hint={{ "True" if a.actuating else "False" }}),
    )
    def {{ a.name }}({% if a.params %}{{ a.params }}, {% endif %}{% if a.actuating %}confirm: bool = False{% endif %}) -> str:
{% if a.actuating %}
        _require_confirmation({{ a.name|tojson }}, confirm)
{% endif %}
{% if a.returns == "None" %}
        driver.{{ a.name }}({{ a.param_names }})
        return "ok"
{% else %}
        return str(driver.{{ a.name }}({{ a.param_names }}))
{% endif %}
{% endfor %}
{% for s in ctx.streams %}

    @server.tool(
        name={{ s.name|tojson }},
        description={{ ("Read the next " ~ s.message.name ~ " message streamed by the instrument.")|tojson }},
        annotations=ToolAnnotations(read_only_hint=True, destructive_hint=False),
    )
    def {{ s.name }}(timeout: float = 1.0) -> dict[str, Any]:
        return asdict(driver.{{ s.name }}(timeout=timeout))
{% endfor %}

    return server


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--resource", default=DEFAULT_RESOURCE, help="port, VISA resource or tcp://host:port")
    parser.add_argument("--simulate", action="store_true", help="use the in-process replay simulator")
    args = parser.parse_args(argv)
    driver = {{ ctx.class_name }}.simulated() if args.simulate else {{ ctx.class_name }}.connect(args.resource)
    create_server(driver).run("stdio")


if __name__ == "__main__":
    main()
