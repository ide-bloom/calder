[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ ctx.dist_name }}"
version = "0.1.0"
description = "Open driver for the {{ ctx.title }}, generated by Calder from recorded vendor-software sessions."
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
{% for dep in ctx.dependencies %}
    "{{ dep }}",
{% endfor %}
]

[project.optional-dependencies]
mcp = ["mcp>=2.3"]
sila = ["sila2>=0.14"]
test = ["pytest>=8", "mcp>=2.3", "sila2>=0.14", "ruff>=0.8", "mypy>=1.13"]

[project.scripts]
{{ ctx.dist_name }}-sim = "{{ ctx.package }}.simulator:main"
{{ ctx.dist_name }}-mcp = "{{ ctx.package }}.mcp_server:main"
{{ ctx.dist_name }}-sila = "{{ ctx.package }}.sila.server:main"

[tool.hatch.build.targets.wheel]
packages = ["{{ ctx.package }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
addopts = "-ra"

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "UP", "N", "SIM", "RUF"]
# Generated call sites can be long; formatting is left to the project adopting the driver.
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
"{{ ctx.package }}/sila/server.py" = ["N802", "N803"]

[tool.mypy]
strict = true
python_version = "3.12"
files = ["{{ ctx.package }}", "tests"]
