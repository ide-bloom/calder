FEATURE = Feature(Path(__file__).with_name("{{ ctx.feature_id }}.sila.xml").read_text(encoding="utf-8"))


class {{ ctx.feature_id }}Impl(FeatureImplementationBase):
    """Maps each SiLA command onto the generated driver."""

    def __init__(self, parent_server: SilaServer, driver: {{ ctx.class_name }}) -> None:
        super().__init__(parent_server)
        self.driver = driver
{% for m in ctx.messages %}

    def {{ m.sila_id }}(self, {% for f in m.inputs %}{{ f.sila_id }}: {{ f.sila_py }}, {% endfor %}*, metadata: Any) -> {{ m.sila_return }}:
        del metadata
{% if m.return_kind == "none" %}
        self.driver.{{ m.method }}({% for f in m.inputs %}{{ f.name }}={{ f.sila_arg }}{% if not loop.last %}, {% endif %}{% endfor %})
{% elif m.return_kind == "value" %}
        result = self.driver.{{ m.method }}({% for f in m.inputs %}{{ f.name }}={{ f.sila_arg }}{% if not loop.last %}, {% endif %}{% endfor %})
        return {{ m.sila_result }}
{% else %}
        result = self.driver.{{ m.method }}({% for f in m.inputs %}{{ f.name }}={{ f.sila_arg }}{% if not loop.last %}, {% endif %}{% endfor %})
        return ({% for expr in m.sila_results %}{{ expr }}, {% endfor %})
{% endif %}
{% endfor %}


def create_server(driver: {{ ctx.class_name }}) -> SilaServer:
    server = SilaServer(
        server_name={{ ("Liberated " ~ ctx.title)|tojson }},
        server_type="LiberatedInstrument",
        server_description="SiLA 2 server generated by Calder from recorded vendor-software sessions.",
        server_version="0.1",
        server_vendor_url="https://github.com/ide-bloom/calder",
    )
    server.set_feature_implementation(FEATURE, {{ ctx.feature_id }}Impl(server, driver))
    return server


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--resource", default=DEFAULT_RESOURCE)
    parser.add_argument("--simulate", action="store_true")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=50052)
    args = parser.parse_args(argv)
    driver = {{ ctx.class_name }}.simulated() if args.simulate else {{ ctx.class_name }}.connect(args.resource)
    server = create_server(driver)
    server.start_insecure(args.host, args.port, enable_discovery=False)
    print(f"SiLA 2 server on {args.host}:{args.port}", flush=True)
    try:
        while True:
            time.sleep(1.0)
    except KeyboardInterrupt:
        server.stop()


if __name__ == "__main__":
    main()
