def test_every_recorded_exchange_decodes() -> None:
    codec = Codec(SPEC)
    for exchange in SPEC.exchanges:
        request = codec.decode(exchange.request, direction="tx", expected=exchange.message)
        assert request.id == exchange.message
        for raw in exchange.responses:
            response = codec.decode(raw, direction="rx", expected=exchange.response_message)
            assert response.id == exchange.response_message


def test_recorded_requests_round_trip() -> None:
    codec = Codec(SPEC)
    for exchange in SPEC.exchanges:
        message = SPEC.message(exchange.message)
        if any(f.role == "counter" for f in message.fields):
            continue
        decoded = codec.decode(exchange.request, direction="tx", expected=exchange.message)
        assert codec.encode(message, decoded.values) == exchange.request


def test_simulator_answers_recorded_requests() -> None:
    simulator = ReplaySimulator(SPEC)
    codec = Codec(SPEC)
    for exchange in SPEC.exchanges[:200]:
        if not exchange.responses or exchange.response_message is None:
            continue
        reply = simulator.respond(exchange.request)
        assert codec.decode(reply, direction="rx", expected=exchange.response_message).id == exchange.response_message
